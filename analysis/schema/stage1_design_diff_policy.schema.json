{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.llnl.gov/schemas/stage1_design_diff_policy.schema.json",
  "title": "Hash-bound Stage 1 design-diff policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "intended_use",
    "orientation_verification",
    "deletion_labeling"
  ],
  "properties": {
    "schema_version": {
      "const": "part2-stage1-design-diff-policy/1.0.0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "intended_use": {
      "enum": ["production", "test_fixture"]
    },
    "orientation_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "sample_start",
        "sample_end",
        "maximum_ranked_edges",
        "scale_candidates_mm_per_design_unit",
        "ambiguity_absolute_mm",
        "ambiguity_relative_fraction",
        "reflection_authorized",
        "expected_counts",
        "verification_tolerances"
      ],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 2},
        "sample_start": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5},
        "sample_end": {"type": "number", "minimum": 0.5, "exclusiveMaximum": 1},
        "maximum_ranked_edges": {"type": "integer", "minimum": 1},
        "scale_candidates_mm_per_design_unit": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "ambiguity_absolute_mm": {"type": "number", "minimum": 0},
        "ambiguity_relative_fraction": {"type": "number", "minimum": 0},
        "reflection_authorized": {"type": "boolean"},
        "expected_counts": {"$ref": "#/$defs/counts"},
        "verification_tolerances": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scale_absolute_mm_per_design_unit",
            "design_center_absolute_design_unit",
            "rotation_orthonormal_absolute",
            "rotation_determinant_absolute",
            "translation_search_match_absolute_mm",
            "geometry_equivalence_absolute_mm",
            "maximum_edge_support_distance_mm",
            "maximum_edge_support_p99_minus_p01_mm"
          ],
          "properties": {
            "scale_absolute_mm_per_design_unit": {"type": "number", "exclusiveMinimum": 0},
            "design_center_absolute_design_unit": {"type": "number", "exclusiveMinimum": 0},
            "rotation_orthonormal_absolute": {"type": "number", "exclusiveMinimum": 0},
            "rotation_determinant_absolute": {"type": "number", "exclusiveMinimum": 0},
            "translation_search_match_absolute_mm": {"type": "number", "minimum": 0},
            "geometry_equivalence_absolute_mm": {"type": "number", "minimum": 0},
            "maximum_edge_support_distance_mm": {"type": "number", "exclusiveMinimum": 0},
            "maximum_edge_support_p99_minus_p01_mm": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "deletion_labeling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "sample_start",
        "sample_end",
        "radius_margin_mm",
        "radius_rounding_mm",
        "split_seed",
        "development_fraction",
        "x_bins",
        "z_shells",
        "expected_deletions"
      ],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 2},
        "sample_start": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5},
        "sample_end": {"type": "number", "minimum": 0.5, "exclusiveMaximum": 1},
        "radius_margin_mm": {"type": "number", "minimum": 0},
        "radius_rounding_mm": {"type": "number", "exclusiveMinimum": 0},
        "split_seed": {"type": "integer", "minimum": 0},
        "development_fraction": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "x_bins": {"type": "integer", "minimum": 1},
        "z_shells": {"type": "integer", "minimum": 1},
        "expected_deletions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["0p1", "0p5", "1p0"],
          "properties": {
            "0p1": {"type": "integer", "minimum": 0},
            "0p5": {"type": "integer", "minimum": 0},
            "1p0": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "cells"],
      "properties": {
        "nodes": {"type": "integer", "minimum": 1},
        "edges": {"type": "integer", "minimum": 1},
        "cells": {"type": "integer", "minimum": 1}
      }
    }
  }
}
