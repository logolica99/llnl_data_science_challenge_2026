{
  "schema_version": "agent-stage-contract/1.0.0",
  "stage_number": 0,
  "stage": "specimen_ingest",
  "owner": "specimen_ingest",
  "invoked_by": "orchestrator",
  "execution_kind": "hybrid",
  "maximum_attempts": 2,
  "one_shot": false,
  "required_dependencies": {
    "agents": [
      {"name": "specimen_ingest", "contract_version": "agent-stage-contract/1.0.0"}
    ],
    "mcp_tools": [
      {"server": "segmentation-tools", "name": "inspect_volume_metadata", "response_schema_version": "part2-mcp-response/1.0.0"},
      {"server": "segmentation-tools", "name": "load_lattice_graph", "response_schema_version": "part2-mcp-response/1.0.0"}
    ]
  },
  "required_inputs": [
    "scientist_confirmed_specimen_and_design_ids",
    "requested_analysis_scope",
    "nominal_graph_json",
    "specimen_ct_volume",
    "graph_axes_and_ct_array_axes"
  ],
  "optional_inputs": [],
  "required_outputs": [
    "analysis/<specimen_id>/design/normalized_nominal_graph.npz",
    "analysis/<specimen_id>/config/ct_metadata_response.json",
    "analysis/<specimen_id>/config/ct_metadata_mcp_call_receipt.json",
    "analysis/<specimen_id>/config/ingest_request.json",
    "analysis/<specimen_id>/config/specimen_manifest.json",
    "analysis/<specimen_id>/config/ingest_receipt.json",
    "analysis/<specimen_id>/config/data_prep_handoff.json"
  ],
  "forbidden_operations": [
    "filename_or_directory_proximity_association",
    "cad_or_stl_requirement",
    "aligned_graph_access",
    "segmentation",
    "registration",
    "defect_label_derivation",
    "mcp_cli_or_direct_import_fallback"
  ],
  "input_artifacts": {
    "allowed": [
      {"role": "stage_handoff", "path": "analysis/<specimen_id>/handoffs/stage_0_specimen_ingest_attempt_<attempt>.json", "consumers": ["specimen_ingest"]},
      {"role": "scientist_intake_request", "path": "analysis/<specimen_id>/config/runtime_request.json", "consumers": ["specimen_ingest"]},
      {"role": "nominal_graph", "path": "<scientist-confirmed-nominal-graph-json>", "consumers": ["specimen_ingest", "load_lattice_graph"]},
      {"role": "ct_volume", "path": "<scientist-confirmed-ct-volume>", "consumers": ["specimen_ingest", "inspect_volume_metadata"]},
      {"role": "specimen_manifest_schema", "path": "analysis/schema/specimen_manifest.schema.json", "consumers": ["specimen_ingest"]},
      {"role": "volume_metadata_skill", "path": ".agents/skills/volume-metadata/SKILL.md", "consumers": ["specimen_ingest"]}
    ],
    "required_roles": ["stage_handoff", "scientist_intake_request", "nominal_graph", "ct_volume", "specimen_manifest_schema", "volume_metadata_skill"],
    "forbidden": [
      {"role": "cad_or_stl", "path": "**/*.stl"},
      {"role": "aligned_graph", "path": "<aligned-graph>"},
      {"role": "defect_labels", "path": "analysis/<specimen_id>/labels/**"},
      {"role": "segmentation_mask", "path": "analysis/<specimen_id>/segmentation/**"},
      {"role": "registration_output", "path": "analysis/<specimen_id>/registration/**"},
      {"role": "other_specimen_manifest", "path": "analysis/<other-specimen-id>/config/specimen_manifest.json"}
    ]
  },
  "output_artifacts": {
    "allowed": [
      {"role": "manual_review_evidence", "path": "analysis/<specimen_id>/reviews/stage_0_attempt_<attempt>/**", "allow_multiple": true},
      {"role": "normalized_nominal_graph", "path": "analysis/<specimen_id>/design/normalized_nominal_graph.npz"},
      {"role": "ingest_request", "path": "analysis/<specimen_id>/config/ingest_request.json"},
      {"role": "ct_metadata_mcp_response", "path": "analysis/<specimen_id>/config/ct_metadata_response.json"},
      {"role": "ct_metadata_mcp_call_receipt", "path": "analysis/<specimen_id>/config/ct_metadata_mcp_call_receipt.json"},
      {"role": "specimen_manifest", "path": "analysis/<specimen_id>/config/specimen_manifest.json"},
      {"role": "ingest_receipt", "path": "analysis/<specimen_id>/config/ingest_receipt.json"},
      {"role": "data_prep_handoff", "path": "analysis/<specimen_id>/config/data_prep_handoff.json"}
    ],
    "required_roles": ["normalized_nominal_graph", "ingest_request", "ct_metadata_mcp_response", "ct_metadata_mcp_call_receipt", "specimen_manifest", "ingest_receipt", "data_prep_handoff"]
  },
  "required_receipt_assertions": [
    "contract_version_matches",
    "association_explicit",
    "all_paths_repository_relative",
    "all_supplied_inputs_hashed",
    "ct_metadata_mcp_integrity_chain_valid",
    "nominal_graph_normalized_by_mcp",
    "graph_ids_references_and_topology_valid",
    "normalized_graph_path_and_hash_bound",
    "manifest_schema_valid",
    "canonical_ingest_receipt_hash_valid",
    "accessed_inputs_within_allowlist",
    "forbidden_inputs_not_accessed",
    "segmentation_not_run",
    "registration_not_run",
    "defect_labels_not_derived",
    "output_artifact_hashes_match"
  ],
  "next_stage": "data_prep",
  "unlock_condition": {"terminal_state": "pass", "completion_receipt_verified": true, "matching_hashes_required": true, "next_stage_locked_until_verified": true},
  "manual_review_conditions": ["unknown_or_conflicting_units_or_axis_conventions", "scientist_association_requires_correction"],
  "halt_conditions": ["missing_or_schema_incompatible_dependency", "invalid_nominal_graph_or_ct", "receipt_or_artifact_hash_mismatch", "attempt_limit_reached"]
}
