{
  "schema_version": "agent-stage-contract/1.0.0",
  "stage_number": 5,
  "stage": "sealed_evaluation",
  "owner": "eval_agent",
  "invoked_by": "orchestrator",
  "execution_kind": "one_shot",
  "maximum_attempts": 1,
  "one_shot": true,
  "required_dependencies": {
    "agents": [
      {
        "name": "eval_agent",
        "contract_version": "agent-stage-contract/1.0.0"
      }
    ],
    "mcp_tools": [
      {
        "server": "segmentation-tools",
        "name": "compute_detection_metrics",
        "response_schema_version": "part2-mcp-response/1.0.0"
      }
    ]
  },
  "required_inputs": [
    "verified_stage_4_receipt_hash_in_control_metadata",
    "attempt_scoped_stage_5_handoff",
    "classifier_verifier_report",
    "frozen_analysis_config",
    "frozen_classifications",
    "frozen_thresholds",
    "intentional_deletion_labels_0p5",
    "sealed_split_for_eval_agent_only",
    "candidate_evidence_packets"
  ],
  "optional_inputs": [
    "triage_judge_rubric",
    "triage_calibration_items"
  ],
  "required_outputs": [
    "evals/results/<timestamp>.json",
    "analysis/<specimen_id>/struts/attributed_struts.json",
    "analysis/<specimen_id>/triage/triage_results.json",
    "analysis/<specimen_id>/triage/human_spot_check.json"
  ],
  "forbidden_operations": [
    "development_split_access",
    "threshold_modification",
    "classification_modification",
    "metric_or_evidence_recomputation",
    "sealed_scoring_retry",
    "sealed_result_replacement",
    "recall_as_pass_fail_optimization_gate",
    "precision_or_f1_against_intentional_deletion_labels",
    "sealed_label_export_to_downstream_agents",
    "mcp_cli_or_direct_import_fallback"
  ],
  "input_artifacts": {
    "allowed": [
      {
        "role": "stage_handoff",
        "path": "analysis/<specimen_id>/handoffs/stage_5_sealed_evaluation_attempt_<attempt>.json",
        "consumers": [
          "eval_agent"
        ]
      },
      {
        "role": "analysis_config",
        "path": "analysis/<specimen_id>/config/analysis_config.json",
        "consumers": [
          "eval_agent"
        ]
      },
      {
        "role": "classifier_verifier_report",
        "path": "analysis/<specimen_id>/struts/verifier_report.json",
        "consumers": [
          "eval_agent"
        ]
      },
      {
        "role": "classified_struts",
        "path": "analysis/<specimen_id>/struts/classified_struts.json",
        "consumers": [
          "eval_agent",
          "compute_detection_metrics"
        ]
      },
      {
        "role": "classification_thresholds",
        "path": "analysis/<specimen_id>/struts/thresholds.json",
        "consumers": [
          "eval_agent"
        ]
      },
      {
        "role": "intentional_deletions_0p5",
        "path": "analysis/<specimen_id>/labels/intentional_deletions_0p5.json",
        "consumers": [
          "eval_agent"
        ],
        "phases": [
          "attribution"
        ]
      },
      {
        "role": "sealed_labels",
        "path": "evals/labels/sealed_split.json",
        "consumers": [
          "eval_agent"
        ],
        "phases": [
          "one_shot_scoring"
        ]
      },
      {
        "role": "evidence_packets",
        "path": "analysis/<specimen_id>/evidence/strut_<id>/**",
        "allow_multiple": true,
        "consumers": [
          "eval_agent"
        ],
        "phases": [
          "candidate_unintentional_triage"
        ]
      },
      {
        "role": "triage_rubric",
        "path": "evals/rubric_defect_triage.md",
        "consumers": [
          "eval_agent"
        ],
        "phases": [
          "candidate_unintentional_triage"
        ]
      }
    ],
    "required_roles": [
      "stage_handoff",
      "analysis_config",
      "classifier_verifier_report",
      "classified_struts",
      "classification_thresholds",
      "intentional_deletions_0p5",
      "sealed_labels",
      "evidence_packets"
    ],
    "forbidden": [
      {
        "role": "development_labels",
        "path": "analysis/<specimen_id>/labels/dev_split.json"
      },
      {
        "role": "mutable_classification_policy",
        "path": "<unfrozen-classification-thresholds>"
      }
    ]
  },
  "output_artifacts": {
    "allowed": [
      {
        "role": "manual_review_evidence",
        "path": "analysis/<specimen_id>/reviews/stage_5_attempt_<attempt>/**",
        "allow_multiple": true
      },
      {
        "role": "sealed_evaluation_result",
        "path": "evals/results/<timestamp>.json"
      },
      {
        "role": "attributed_struts",
        "path": "analysis/<specimen_id>/struts/attributed_struts.json"
      },
      {
        "role": "triage_results",
        "path": "analysis/<specimen_id>/triage/triage_results.json"
      },
      {
        "role": "human_spot_check",
        "path": "analysis/<specimen_id>/triage/human_spot_check.json"
      }
    ],
    "required_roles": [
      "sealed_evaluation_result",
      "attributed_struts",
      "triage_results",
      "human_spot_check"
    ],
    "sensitive_roles": {
      "sealed_evaluation_result": {
        "must_not_embed_raw_sealed_split": true,
        "authorized_consumers": [
          "eval_agent",
          "report_agent",
          "orchestrator"
        ]
      },
      "attributed_struts": {
        "authorized_consumers": [
          "eval_agent",
          "report_agent",
          "orchestrator"
        ]
      }
    }
  },
  "required_receipt_assertions": [
    "contract_version_matches",
    "stage_4_receipt_hash_matches",
    "classifier_verifier_report_passed",
    "frozen_config_hash_matches",
    "classifications_and_thresholds_hashes_match_stage_4",
    "input_artifact_hashes_match",
    "output_artifact_hashes_match",
    "sealed_split_agent_readers_exactly_eval_agent",
    "sealed_split_path_and_hash_disclosed_only_in_eval_agent_scope",
    "sealed_split_used_only_by_eval_agent_invoked_compute_detection_metrics",
    "sealed_scoring_invocation_count_equals_one",
    "one_shot_marker_bound_to_config_classification_and_sealed_hashes",
    "strict_and_lenient_recall_include_wilson_95_intervals",
    "four_class_confusion_matrix_complete",
    "precision_and_f1_not_reported",
    "recall_value_not_used_as_unlock_gate",
    "attribution_is_exhaustive",
    "triage_repeats_and_calibration_passed",
    "raw_sealed_labels_not_copied_to_outputs",
    "accessed_inputs_within_consumer_and_phase_allowlists",
    "forbidden_inputs_not_accessed"
  ],
  "next_stage": "nde_report",
  "unlock_condition": {
    "terminal_state": "pass",
    "completion_receipt_verified": true,
    "matching_hashes_required": true,
    "frozen_config_hash_required": true,
    "one_shot_reporting_complete": true,
    "recall_threshold_not_required": true,
    "next_stage_locked_until_verified": true
  },
  "manual_review_conditions": [
    "triage_judgment_requires_review_after_frozen_scoring_result",
    "resume_must_reuse_existing_sealed_scoring_artifact_without_rescoring"
  ],
  "halt_conditions": [
    "missing_or_schema_incompatible_dependency",
    "sealed_scoring_already_consumed_for_different_inputs",
    "attempt_to_retry_or_replace_sealed_result",
    "classifier_verifier_requirement_not_met",
    "development_split_access",
    "upstream_threshold_classification_or_config_hash_changed",
    "receipt_or_artifact_hash_mismatch",
    "sealed_label_leakage",
    "one_shot_attempt_exhausted"
  ]
}
